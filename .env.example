# Tollbooth — copy to .env (gitignored, never commit). See PRD F7.
# Only keys for your preset are needed; the bench/demo run simulated ($0).

# --- Preset ---
TOLLBOOTH_PRESET=balanced

# --- Stage preference overlays (ordered; first configured key wins) ---
BULK_PREFERENCE=
REASON_PREFERENCE=

# --- Vendor keys (fill only what your preset uses) ---
OPENAI_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=

# --- Governor caps (enforced, PRD G1) ---
TOLLBOOTH_MAX_PER_TASK_USD=2.00
TOLLBOOTH_MAX_PER_DAY_USD=50.00
